{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tsup": false,
  "vitest": false,
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    "packages/core": {
      "entry": ["src/components/**/index.ts", "src/**/*.test.ts", "src/test/setup.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@testing-library/preact",
        "@kamod-ch/themes",
        "embla-carousel",
        "embla-carousel-autoplay"
      ],
      "ignore": [
        "src/components/dialog/useModalPanelA11y.ts",
        "src/components/sonner/sonner-store.ts",
        "src/components/avatar/types.ts"
      ]
    },
    "packages/openui": {
      "entry": [
        "src/compat/index.ts",
        "src/security/index.ts",
        "src/tokens/index.ts",
        "src/**/*.test.{ts,tsx}",
        "src/test/setup.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/themes": {
      "entry": ["src/**/*.test.{ts,tsx}", "src/test/setup.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/docs": {
      "entry": [
        ".preactpress/config.ts",
        "index.html",
        "src/main.tsx",
        "src/kitchen-sink/KitchenSinkPage.tsx",
        "src/docs/**/*.{ts,tsx}",
        "e2e/**/*.ts",
        "scripts/**/*.{js,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", ".preactpress/**/*.ts"],
      "ignoreBinaries": ["serve"],
      "ignoreDependencies": [
        "@preact/preset-vite",
        "tailwindcss",
        "tw-animate-css",
        "@fontsource-variable/inter",
        "@tailwindcss/forms"
      ],
      "ignore": ["src/base-path.ts", "src/theme/theme-presets.ts"]
    }
  }
}
