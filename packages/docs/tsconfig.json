{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "vitest"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@kamod-ch/ui": ["../core/src/index.ts"],
      "@kamod-ch/preactpress/config": ["./node_modules/@kamod-ch/preactpress/dist/node/config-helpers.d.ts"],
