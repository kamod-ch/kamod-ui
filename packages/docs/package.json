{
  "name": "@kamod-ch/ui-docs",
  "version": "0.0.0",
  "private": true,
  "description": "PreactPress documentation site for Kamod UI — the Preact UI component library",
  "type": "module",
  "scripts": {
    "brand:sync": "node ./scripts/sync-brand-assets.mjs",
    "docs:routes": "node ./scripts/generate-docs-route-manifest.mjs",
    "dev": "pnpm brand:sync && pnpm docs:routes && node ../../scripts/generate-component-docs.mjs --if-stale && preactpress dev",
    "build": "pnpm brand:sync && pnpm docs:routes && node ../../scripts/generate-component-docs.mjs --no-build && preactpress build",
    "preview": "pnpm brand:sync && pnpm docs:routes && preactpress preview",
    "preview:pages": "node ./scripts/preview-github-pages.mjs",
    "check": "pnpm docs:routes && preactpress check",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "qa:themes": "node ./scripts/theme-regression-check.mjs",
    "blocks:thumbnails": "node scripts/generate-block-thumbnails.mjs",
    "blocks:downloads": "node scripts/lib/sidebar-downloads.mjs"
  },
  "dependencies": {
    "@blobatar/preact": "^2.7.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@formisch/preact": "1.3.0",
    "@kamod-ch/blocks": "workspace:*",
    "@kamod-ch/brand": "^0.4.0",
    "@kamod-ch/hooks": "^1.0.0",
    "@kamod-ch/icons": "^2.0.0",
    "@kamod-ch/motion": "^0.1.0",
    "@kamod-ch/openui": "workspace:*",
    "@kamod-ch/signals": "^1.0.3",
    "@kamod-ch/themes": "workspace:*",
    "@kamod-ch/typeset": "workspace:*",
    "@kamod-ch/ui": "workspace:*",
    "@kamod-ch/ui-motion": "workspace:*",
    "@openuidev/react-lang": "^1.1.1",
    "@preact/signals": "^2.11.4",
    "@tailwindcss/forms": "^0.5.11",
    "blobatar": "^2.7.0",
    "chrono-node": "^2.10.3",
    "lucide-preact": "^1.73.0",
    "marked": "18.2.0",
    "motion": "^14.14.0",
    "preact": "^11.2.0",
    "prismjs": "^1.30.0",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@kamod-ch/preactpress": "^3.3.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@types/prismjs": "^1.26.6",
    "axe-core": "^4.14.0",
    "fflate": "0.8.3",
    "jsdom": "^31.0.1",
    "preact-render-to-string": "^6.8.3",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
