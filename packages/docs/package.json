{
  "name": "@kamod-ch/ui-docs",
  "version": "0.0.0",
  "private": true,
  "description": "PreactPress documentation site for @kamod-ch/ui",
  "type": "module",
  "scripts": {
    "brand:sync": "node ./scripts/sync-brand-assets.mjs",
    "docs:routes": "node ./scripts/generate-docs-route-manifest.mjs",
    "dev": "pnpm brand:sync && pnpm docs:routes && preactpress dev",
    "build": "pnpm brand:sync && pnpm docs:routes && preactpress build",
    "preview": "pnpm brand:sync && pnpm docs:routes && preactpress preview",
    "preview:pages": "node ./scripts/preview-github-pages.mjs",
    "check": "pnpm docs:routes && preactpress check",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "qa:themes": "node ./scripts/theme-regression-check.mjs",
    "blocks:thumbnails": "node scripts/generate-block-thumbnails.mjs",
    "blocks:downloads": "node scripts/lib/sidebar-downloads.mjs"
  },
  "dependencies": {
    "@blobatar/preact": "^2.7.0",
    "@formisch/preact": "1.1.0",
    "@kamod-ch/blocks": "workspace:*",
    "@kamod-ch/brand": "^0.4.0",
    "@kamod-ch/hooks": "^1.0.0",
    "@kamod-ch/icons": "^2.0.0",
    "@kamod-ch/motion": "^0.1.0",
    "@kamod-ch/openui": "workspace:*",
    "@kamod-ch/signals": "^1.0.3",
    "@kamod-ch/themes": "workspace:*",
    "@kamod-ch/typeset": "workspace:*",
    "@kamod-ch/ui": "workspace:*",
    "@kamod-ch/ui-motion": "workspace:*",
    "@openuidev/react-lang": "^1.0.1",
    "@preact/signals": "^2.11.3",
    "@tailwindcss/forms": "^0.5.11",
    "blobatar": "^2.7.0",
    "chrono-node": "^2.10.3",
    "lucide-preact": "^1.59.0",
    "marked": "18.1.1",
    "motion": "^14.3.0",
    "preact": "^11.0.1",
    "prismjs": "^1.30.0",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@kamod-ch/preactpress": "^3.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/prismjs": "^1.26.6",
    "axe-core": "^4.14.0",
    "fflate": "0.8.3",
    "jsdom": "^30.1.3",
    "preact-render-to-string": "^6.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
