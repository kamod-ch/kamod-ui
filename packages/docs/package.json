{
  "name": "@kamod-ch/ui-docs",
  "version": "0.0.0",
  "private": true,
  "description": "PreactPress documentation site for @kamod-ch/ui",
  "type": "module",
  "scripts": {
    "brand:sync": "kamod-brand-sync-docs --target public",
    "docs:routes": "node ./scripts/generate-docs-route-manifest.mjs",
    "dev": "pnpm brand:sync && pnpm docs:routes && preactpress dev",
    "build": "pnpm brand:sync && pnpm docs:routes && preactpress build",
    "preview": "pnpm brand:sync && pnpm docs:routes && preactpress preview",
    "preview:pages": "node ./scripts/preview-github-pages.mjs",
    "check": "pnpm docs:routes && preactpress check",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "qa:themes": "node ./scripts/theme-regression-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@formisch/preact": "1.0.0-rc.0",
    "@kamod-ch/blocks": "workspace:*",
    "@kamod-ch/brand": "^0.1.0",
    "@kamod-ch/hooks": "^1.0.0",
    "@kamod-ch/icons": "^1.0.3",
    "@kamod-ch/motion": "^0.1.0",
    "@kamod-ch/openui": "workspace:*",
    "@kamod-ch/signals": "^1.0.3",
    "@kamod-ch/themes": "workspace:*",
    "@kamod-ch/typeset": "workspace:*",
    "@kamod-ch/ui": "workspace:*",
    "@kamod-ch/ui-motion": "workspace:*",
    "@openuidev/react-lang": "^0.2.8",
    "@preact/signals": "^2.9.1",
    "@tailwindcss/forms": "^0.5.11",
    "chrono-node": "^2.9.1",
    "lucide-preact": "^1.17.0",
    "motion": "^13.1.1",
    "preact": "^10.29.2",
    "prismjs": "^1.30.0",
    "valibot": "^1.4.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@kamod-ch/preactpress": "^2.1.0",
    "@playwright/test": "^1.60.0",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.3.0",
    "@types/prismjs": "^1.26.6",
    "axe-core": "^4.11.4",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
