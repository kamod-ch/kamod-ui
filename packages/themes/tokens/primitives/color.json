{
  "$description": "DTCG 2025.10 color primitives. OKLCH values are the Tailwind v4 defaults previously referenced as var(--color-neutral-*) and var(--color-red-*). Hex values keep the Watson and white/black notation. These primitives are not published as CSS variables.",
  "color": {
    "white": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
    },
    "black": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" }
    },
