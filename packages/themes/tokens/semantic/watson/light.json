{
  "$description": "Watson light roles. Brand palette stays in primitives; these aliases are the UI roles.",
  "color": {
    "background": { "$type": "color", "$value": "{color.white}" },
    "foreground": { "$type": "color", "$value": "{color.black}" },
    "card": {
      "fill": { "$type": "color", "$value": "{color.watson.grey.10}" },
      "foreground": { "$type": "color", "$value": "{color.black}" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{color.watson.pink.100}" },
      "on-primary": { "$type": "color", "$value": "{color.white}" },
      "primary-accent": { "$type": "color", "$value": "{color.watson.aubergine.100}" }
    },
    "muted": {
      "fill": { "$type": "color", "$value": "{color.watson.grey.10}" },
      "foreground": { "$type": "color", "$value": "{color.watson.grey.100}" }
    },
    "border": { "$type": "color", "$value": "{color.watson.grey.20}" },
    "input": { "$type": "color", "$value": "{color.watson.grey.20}" },
    "outline": { "$type": "color", "$value": "{color.black}" },
    "ring": { "$type": "color", "$value": "{color.outline}" },
    "error": {
      "fill": { "$type": "color", "$value": "{color.watson.red}" },
      "foreground": { "$type": "color", "$value": "{color.black}" }
    },
    "destructive": {
      "fill": { "$type": "color", "$value": "{color.error.fill}" },
      "foreground": { "$type": "color", "$value": "{color.error.foreground}" }
    },
    "watson": {
      "surface": { "$type": "color", "$value": "{color.watson.grey.10}" },
      "surface-active": { "$type": "color", "$value": "{color.watson.grey.20}" },
      "surface-control": { "$type": "color", "$value": "{color.watson.graphite.100}" },
      "on-control": { "$type": "color", "$value": "{color.white}" },
      "divider": { "$type": "color", "$value": "{color.watson.grey.20}" },
      "text-label": { "$type": "color", "$value": "{color.watson.grey.100}" },
      "text-placeholder": { "$type": "color", "$value": "{color.watson.grey.100}" },
      "focus-ring": { "$type": "color", "$value": "{color.black}" },
      "accent-text": { "$type": "color", "$value": "{color.watson.aubergine.100}" }
    }
  },
  "radius": {
    "base": {
      "$type": "dimension",
      "$description": "6px base. radius-md is 4px and radius-xl is 10px through the existing Tailwind derivation.",
      "$value": { "value": 6, "unit": "px" }
    }
  }
}
