{
  "name": "@kamod-ch/typeset",
  "version": "0.1.0",
  "description": "Framework-independent CSS typography and content styling for Kamod UI themes.",
  "keywords": [
    "css",
    "kamod",
    "markdown",
    "tailwind",
    "typography"
  ],
  "homepage": "https://kamod-ch.github.io/kamod-ui/",
  "license": "MIT",
  "author": "Klaus Zahiragic <watzak>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/kamod-ui.git",
    "directory": "packages/typeset"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/typeset.css",
    "./typeset.css": "./dist/typeset.css",
    "./presets.css": "./dist/presets.css",
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./generator": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
